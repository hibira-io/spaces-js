{
  "name": "@hibira-io/spaces",
  "version": "0.1.0",
  "description": "Multiplayer collaboration for pusher-js and Laravel Echo on presence channels: who's online, live cursors, component locks and follow mode, with no extra server",
  "keywords": [
    "pusher",
    "pusher-js",
    "laravel-echo",
    "presence",
    "collaboration",
    "multiplayer",
    "live-cursors",
    "avatar-stack",
    "component-locking",
    "websocket",
    "realtime",
    "hibira"
  ],
  "homepage": "https://github.com/hibira-io/spaces-js#readme",
  "bugs": {
    "url": "https://github.com/hibira-io/spaces-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hibira-io/spaces-js.git"
  },
  "license": "MIT",
  "author": "Hibira (https://hibira.io)",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/e2e/*.e2e.mjs"
  },
  "peerDependencies": {
    "pusher-js": ">=7"
  },
  "peerDependenciesMeta": {
    "pusher-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
